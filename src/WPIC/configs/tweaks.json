{
  // Список твиков для вкладки «Твики системы».
  // Реестр и systemParameter откатываются из исходной копии; команды используют undoCommand.
  // Уровни риска: green (безопасно), yellow (требует внимания), red (рискованно).
  "tweaks": [
    {
      "id": "show-file-extensions",
      "category": "explorer",
      "name": "Показывать расширения файлов",
      "description": "В Проводнике будут видны расширения всех файлов (.txt, .exe и т.д.). Требует перезапуска Проводника — выполняется автоматически.",
      "risk": "green",
      "actions": [
        {
          "type": "registry",
          "key": "HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
          "valueName": "HideFileExt",
          "regType": "DWord",
          "value": "0"
        },
        {
          "type": "command",
          "command": "taskkill /f /im explorer.exe && start explorer.exe",
          "undoCommand": "taskkill /f /im explorer.exe && start explorer.exe"
        }
      ]
    },
    {
      "id": "show-hidden-files",
      "category": "explorer",
      "name": "Показывать скрытые файлы",
      "description": "Скрытые и системные файлы станут видны в Проводнике. Требует перезапуска Проводника — выполняется автоматически.",
      "risk": "green",
      "actions": [
        {
          "type": "registry",
          "key": "HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
          "valueName": "Hidden",
          "regType": "DWord",
          "value": "1"
        },
        {
          "type": "command",
          "command": "taskkill /f /im explorer.exe && start explorer.exe",
          "undoCommand": "taskkill /f /im explorer.exe && start explorer.exe"
        }
      ]
    },
    {
