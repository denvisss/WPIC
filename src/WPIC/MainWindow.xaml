<Window x:Class="WPIC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WPIC.Views"
        xmlns:loc="clr-namespace:WPIC.Services"
        Title="Windows Post-Install Client"
        Icon="/WindowsPostInstallClient;component/appicon.ico"
        Style="{DynamicResource {x:Type Window}}"
        Height="780" Width="1100" MinHeight="560" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
    <DockPanel>

        <!-- Шапка -->
        <Border DockPanel.Dock="Top" Padding="14,8"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{loc:L10n main.settings}" MinWidth="0"
                        VerticalAlignment="Center" Click="BtnSettings_Click"/>
                <TextBlock Text="{loc:L10n app.name}" FontSize="15" FontFamily="Consolas" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem x:Name="StatusText" Content="{loc:L10n main.ready}"/>
        </StatusBar>
        <Expander DockPanel.Dock="Bottom" IsExpanded="False">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:L10n main.log}" VerticalAlignment="Center"/>
                    <Button x:Name="BtnOpenLog" Content="{loc:L10n main.log.openFolder}" Margin="14,0,0,0"
                            Padding="8,2" FontSize="11" Click="BtnOpenLog_Click"/>
                </StackPanel>
            </Expander.Header>
            <TextBox x:Name="TxtLog" IsReadOnly="True" Height="150"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"/>
        </Expander>
        <TabControl x:Name="MainTabs">
            <TabItem Style="{DynamicResource MainTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.8"
                              Stroke="{DynamicResource Grad.Blue}" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M4 4 H11 V11 H4 Z M13 4 H20 V11 H13 Z M4 13 H11 V20 H4 Z M13 13 H20 V20 H13 Z"/>
                        <TextBlock Text="{loc:L10n tab.apps}" Margin="10,0,0,0" VerticalAlignment="Center" FontFamily="Consolas"/>
                    </StackPanel>
                </TabItem.Header>
                <views:AppsTab/>
            </TabItem>
            <TabItem Style="{DynamicResource MainTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.8"
                              Stroke="{DynamicResource Grad.Orange}" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M4 7 H20 M4 17 H20 M9 4 V10 M15 14 V20"/>
                        <TextBlock Text="{loc:L10n tab.tweaks}" Margin="10,0,0,0" VerticalAlignment="Center" FontFamily="Consolas"/>
                    </StackPanel>
                </TabItem.Header>
                <views:TweaksTab/>
            </TabItem>
            <TabItem Style="{DynamicResource MainTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.8"
                              Stroke="{DynamicResource Grad.Green}" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M8 8 H16 V16 H8 Z M4 10 H8 M4 14 H8 M16 10 H20 M16 14 H20 M10 4 V8 M14 4 V8 M10 16 V20 M14 16 V20"/>
                        <TextBlock Text="{loc:L10n tab.drivers}" Margin="10,0,0,0" VerticalAlignment="Center" FontFamily="Consolas"/>
                    </StackPanel>
                </TabItem.Header>
                <views:DriversTab x:Name="TabDrivers"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>