<Window x:Class="WPIC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WPIC.Views"
        xmlns:loc="clr-namespace:WPIC.Services"
        Title="Windows Post-Install Client"
        Icon="/WindowsPostInstallClient;component/appicon.ico"
        Style="{DynamicResource {x:Type Window}}"
        Height="780" Width="1100" MinHeight="560" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
    <DockPanel>

        <!-- Шапка -->
        <Border DockPanel.Dock="Top" Padding="14,8"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right" MinWidth="0" VerticalAlignment="Center" Click="BtnSettings_Click">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="18" Height="18">
                            <Path Stretch="Uniform" StrokeThickness="1.6" Stroke="{DynamicResource Grad.Cyan}"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M12 15 A3 3 0 1 0 12 9 A3 3 0 1 0 12 15 Z M19.4 15 A1.65 1.65 0 0 0 19.73 16.82 L19.79 16.88 A2 2 0 0 1 19.79 19.71 A2 2 0 0 1 16.96 19.71 L16.9 19.65 A1.65 1.65 0 0 0 15.08 19.32 A1.65 1.65 0 0 0 14.08 20.83 V21 A2 2 0 0 1 12.08 23 A2 2 0 0 1 10.08 21 V20.91 A1.65 1.65 0 0 0 9 19.4 A1.65 1.65 0 0 0 7.18 19.73 L7.12 19.79 A2 2 0 0 1 4.29 19.79 A2 2 0 0 1 4.29 16.96 L4.35 16.9 A1.65 1.65 0 0 0 4.68 15.08 A1.65 1.65 0 0 0 3.17 14.08 H3 A2 2 0 0 1 1 12.08 A2 2 0 0 1 3 10.08 H3.09 A1.65 1.65 0 0 0 4.6 9 A1.65 1.65 0 0 0 4.27 7.18 L4.21 7.12 A2 2 0 0 1 4.21 4.29 A2 2 0 0 1 7.04 4.29 L7.1 4.35 A1.65 1.65 0 0 0 8.92 4.68 H9 A1.65 1.65 0 0 0 10 3.17 V3 A2 2 0 0 1 12 1 A2 2 0 0 1 14 3 V3.09 A1.65 1.65 0 0 0 15 4.6 A1.65 1.65 0 0 0 16.82 4.27 L16.88 4.21 A2 2 0 0 1 19.71 4.21 A2 2 0 0 1 19.71 7.04 L19.65 7.1 A1.65 1.65 0 0 0 19.32 8.92 V9 A1.65 1.65 0 0 0 20.83 10 H21 A2 2 0 0 1 23 12 A2 2 0 0 1 21 14 H20.91 A1.65 1.65 0 0 0 19.4 15 Z"/>
                            <Ellipse x:Name="DotUpdate" Width="9" Height="9" Fill="{DynamicResource Brush.Danger}"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0"
                                     Visibility="Collapsed"/>
                        </Grid>
                        <TextBlock Text="{loc:L10n main.settings}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="{loc:L10n app.name}" FontSize="15" FontFamily="Consolas" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Панель окружения: winget / Microsoft Store / драйвер сетевой карты -->
        <Border DockPanel.Dock="Top" Margin="8,8,8,0" Padding="12,8" CornerRadius="10"
                Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.8" Stroke="{DynamicResource Grad.Cyan}"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Data="M12 2 L14.5 9 H21.5 L15.5 13.5 L18 21 L12 16.5 L6 21 L8.5 13.5 L2.5 9 H9.5 Z"/>
                    <TextBlock Text="{loc:L10n env.title}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"
                               Margin="8,0,16,0"/>
                    <Ellipse x:Name="DotEnvWinget" Width="9" Height="9" Fill="{DynamicResource Brush.Danger}"
                             VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtEnvWinget" Text="{loc:L10n env.winget}" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12.5"/>
                    <Ellipse x:Name="DotEnvStore" Width="9" Height="9" Fill="{DynamicResource Brush.Danger}"
                             VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <TextBlock Text="{loc:L10n env.store}" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12.5"/>
                    <Ellipse x:Name="DotEnvNic" Width="9" Height="9" Fill="{DynamicResource Brush.Danger}"
                             VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <TextBlock Text="{loc:L10n env.nic}" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12.5"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnEnvWingetInstall" Style="{DynamicResource PrimaryButton}" Padding="10,4" FontSize="12"
                            Content="{loc:L10n env.installWinget}" Visibility="Collapsed" Click="BtnEnvWingetInstall_Click"/>
                    <Button x:Name="BtnEnvWingetStore" Padding="10,4" FontSize="12" Margin="8,0,0,0"
                            Content="{loc:L10n env.installWingetStore}" Visibility="Collapsed" Click="BtnEnvWingetStore_Click"/>
                    <Button x:Name="BtnEnvWingetUpdate" Padding="10,4" FontSize="12"
                            Content="{loc:L10n env.updateWinget}" Visibility="Collapsed" Click="BtnEnvWingetUpdate_Click"/>
                    <Button x:Name="BtnEnvStoreRestore" Padding="10,4" FontSize="12" Margin="8,0,0,0"
                            Content="{loc:L10n env.restoreStore}" Visibility="Collapsed" Click="BtnEnvStoreRestore_Click"/>
                    <Button x:Name="BtnEnvNicFix" Padding="10,4" FontSize="12" Margin="8,0,0,0"
                            Content="{loc:L10n env.installNic}" Visibility="Collapsed" Click="BtnEnvNicFix_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem x:Name="StatusText" Content="{loc:L10n main.ready}"/>
        </StatusBar>
        <Expander DockPanel.Dock="Bottom" IsExpanded="False">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:L10n main.log}" VerticalAlignment="Center"/>
                    <Button x:Name="BtnOpenLog" Content="{loc:L10n main.log.openFolder}" Margin="14,0,0,0"
                            Padding="8,2" FontSize="11" Click="BtnOpenLog_Click"/>
                </StackPanel>
            </Expander.Header>
            <TextBox x:Name="TxtLog" IsReadOnly="True" Height="150"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"/>
        </Expander>
        <TabControl x:Name="MainTabs">
            <TabItem Style="{DynamicResource MainTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.8"
                              Stroke="{DynamicResource Grad.Blue}" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M4 4 H11 V11 H4 Z M13 4 H20 V11 H13 Z M4 13 H11 V20 H4 Z M13 13 H20 V20 H13 Z"/>
                        <TextBlock Text="{loc:L10n tab.apps}" Margin="10,0,0,0" VerticalAlignment="Center" FontFamily="Consolas"/>
                    </StackPanel>
                </TabItem.Header>
                <views:AppsTab/>
            </TabItem>
            <TabItem Style="{DynamicResource MainTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.8"
                              Stroke="{DynamicResource Grad.Pink}" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M4 7 H20 M9 7 V4 H15 V7 M6 7 L7 20 H17 L18 7 M10 11 V16 M14 11 V16"/>
                        <TextBlock Text="{loc:L10n tab.bloat}" Margin="10,0,0,0" VerticalAlignment="Center" FontFamily="Consolas"/>
                    </StackPanel>
                </TabItem.Header>
                <views:BuiltinAppsTab/>
            </TabItem>
            <TabItem Style="{DynamicResource MainTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.8"
                              Stroke="{DynamicResource Grad.Orange}" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M4 7 H20 M4 17 H20 M9 4 V10 M15 14 V20"/>
                        <TextBlock Text="{loc:L10n tab.tweaks}" Margin="10,0,0,0" VerticalAlignment="Center" FontFamily="Consolas"/>
                    </StackPanel>
                </TabItem.Header>
                <views:TweaksTab/>
            </TabItem>
            <TabItem Style="{DynamicResource MainTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.8"
                              Stroke="{DynamicResource Grad.Green}" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M8 8 H16 V16 H8 Z M4 10 H8 M4 14 H8 M16 10 H20 M16 14 H20 M10 4 V8 M14 4 V8 M10 16 V20 M14 16 V20"/>
                        <TextBlock Text="{loc:L10n tab.drivers}" Margin="10,0,0,0" VerticalAlignment="Center" FontFamily="Consolas"/>
                    </StackPanel>
                </TabItem.Header>
                <views:DriversTab x:Name="TabDrivers"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>