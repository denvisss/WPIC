<UserControl x:Class="WPIC.Views.BuiltinAppsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WPIC.Services">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="8">
            <WrapPanel>
                <Button x:Name="BtnRemove" Style="{DynamicResource PrimaryButton}" Margin="0,0,8,8" Content="{loc:L10n bloat.remove}" Click="BtnRemove_Click"/>
                <Button x:Name="BtnRestore" Content="{loc:L10n bloat.restore}" Margin="0,0,8,8" Click="BtnRestore_Click"/>
                <Button x:Name="BtnRefresh" Content="{loc:L10n bloat.refresh}" Margin="0,0,8,8" Click="BtnRefresh_Click"/>
                <Button x:Name="BtnRestorePoint" Content="{loc:L10n tweaks.restorePoint}" Margin="0,0,8,8" Click="BtnRestorePoint_Click"/>
            </WrapPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                <Ellipse Width="9" Height="9" Fill="{DynamicResource Brush.Success}" VerticalAlignment="Center"/>
                <TextBlock Text="{loc:L10n tweaks.risk.green}" Margin="5,0,16,0" Foreground="{DynamicResource Brush.TextSecondary}"/>
                <Ellipse Width="9" Height="9" Fill="{DynamicResource Brush.Warning}" VerticalAlignment="Center"/>
                <TextBlock Text="{loc:L10n tweaks.risk.yellow}" Margin="5,0,16,0" Foreground="{DynamicResource Brush.TextSecondary}"/>
                <Ellipse Width="9" Height="9" Fill="{DynamicResource Brush.Danger}" VerticalAlignment="Center"/>
                <TextBlock Text="{loc:L10n tweaks.risk.red}" Margin="5,0,0,0" Foreground="{DynamicResource Brush.TextSecondary}"/>
            </StackPanel>
            <TextBlock Text="{loc:L10n bloat.notice}" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" FontSize="12"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ItemsApps" Margin="8">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                           Foreground="{DynamicResource Brush.Accent}" Margin="0,12,0,2"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ItemsControl.GroupStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="4,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding IsSelectable}"
                                          AutomationProperties.Name="{Binding Name}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Grid Grid.Column="1" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource Brush.FieldBg}" CornerRadius="6"/>
                                    <Path Width="20" Height="20" Stretch="Uniform" StrokeThickness="1.6"
                                          Stroke="{DynamicResource Brush.TextSecondary}" StrokeLineJoin="Round"
                                          Data="M4 5 H20 V19 H4 Z M4 9 H20 M7 7 H7.01 M10 7 H10.01">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <Image Source="{Binding Icon}" Width="30" Height="30" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <WrapPanel>
                                        <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,1,7,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource Brush.Success}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Risk}" Value="yellow">
                                                            <Setter Property="Fill" Value="{DynamicResource Brush.Warning}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Risk}" Value="red">
                                                            <Setter Property="Fill" Value="{DynamicResource Brush.Danger}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding RiskLabel}" FontSize="11" Margin="8,0,0,0"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                    </WrapPanel>
                                    <WrapPanel Margin="0,4,0,0">
                                        <TextBlock Text="{Binding DateText}" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                        <TextBlock Text="{Binding Status}" FontSize="11" Margin="12,0,0,0"
                                                   Foreground="{DynamicResource Brush.Accent}" TextWrapping="Wrap"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>