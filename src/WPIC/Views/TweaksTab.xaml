<UserControl x:Class="WPIC.Views.TweaksTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WPIC.Services">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="8">
            <WrapPanel>
                <Button x:Name="BtnApply" Style="{DynamicResource PrimaryButton}" Margin="0,0,8,8" Content="{loc:L10n tweaks.apply}" Click="BtnApply_Click"/>
                <Button x:Name="BtnUndo" Content="{loc:L10n tweaks.undo}" Margin="0,0,8,8" Click="BtnUndo_Click"/>
                <Button x:Name="BtnRefresh" Content="{loc:L10n tweaks.refresh}" Margin="0,0,8,8" Click="BtnRefresh_Click"/>
                <Button x:Name="BtnRestorePoint" Content="{loc:L10n tweaks.restorePoint}" Margin="0,0,8,8" Click="BtnRestorePoint_Click"/>
                <Button x:Name="BtnRestoreBackup" Content="{loc:L10n tweaks.restoreBackup}" Margin="0,0,8,8" Click="BtnRestoreBackup_Click"/>
            </WrapPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                <Ellipse Width="9" Height="9" Fill="{DynamicResource Brush.Success}" VerticalAlignment="Center"/>
                <TextBlock Text="{loc:L10n tweaks.risk.green}" Margin="5,0,16,0" Foreground="{DynamicResource Brush.TextSecondary}"/>
                <Ellipse Width="9" Height="9" Fill="{DynamicResource Brush.Warning}" VerticalAlignment="Center"/>
                <TextBlock Text="{loc:L10n tweaks.risk.yellow}" Margin="5,0,16,0" Foreground="{DynamicResource Brush.TextSecondary}"/>
                <Ellipse Width="9" Height="9" Fill="{DynamicResource Brush.Danger}" VerticalAlignment="Center"/>
                <TextBlock Text="{loc:L10n tweaks.risk.red}" Margin="5,0,0,0" Foreground="{DynamicResource Brush.TextSecondary}"/>
            </StackPanel>
            <TextBlock Text="{loc:L10n tweaks.notice}" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" FontSize="12"/>
            <WrapPanel x:Name="PanelCategories" Margin="0,8,0,0"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ItemsTweaks" Margin="8">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                           Foreground="{DynamicResource Brush.Accent}" Margin="0,12,0,2"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ItemsControl.GroupStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="4,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding IsSupported}"
                                          AutomationProperties.Name="{Binding Name}" VerticalAlignment="Top" Margin="0,2,10,0"/>
                                <StackPanel Grid.Column="1">
                                    <WrapPanel>
                                        <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,1,7,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource Brush.Success}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Risk}" Value="yellow">
                                                            <Setter Property="Fill" Value="{DynamicResource Brush.Warning}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Risk}" Value="red">
                                                            <Setter Property="Fill" Value="{DynamicResource Brush.Danger}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding Description}" Margin="0,4,0,0" FontSize="12"
                                               Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap"/>
                                    <WrapPanel Margin="0,5,0,0">
                                        <TextBlock Text="{Binding Compatibility}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" Margin="0,0,12,0"/>
                                        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Brush.Accent}" FontSize="11" TextWrapping="Wrap"/>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding RestartHint}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
