<UserControl x:Class="WPIC.Views.TweaksTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WPIC.Services">
    <UserControl.Resources>
        <Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <StackPanel>
                                <ToggleButton Cursor="Hand" Focusable="False" Content="{TemplateBinding Header}"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent" Padding="12,9">
                                                <DockPanel LastChildFill="True">
                                                    <TextBlock x:Name="Arrow" Text="▸" Margin="0,0,7,0"
                                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                                               VerticalAlignment="Center"/>
                                                    <ContentPresenter ContentSource="Content" RecognizesAccessKey="True"
                                                                      VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Arrow" Property="LayoutTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="90"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="Body" Margin="12,0,12,12"
                                                  Visibility="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="TweakRowTemplate">
            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="6,10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding IsSupported}"
                              AutomationProperties.Name="{Binding Name}" VerticalAlignment="Top" Margin="0,2,10,0"/>
                    <StackPanel Grid.Column="1">
                        <WrapPanel>
                            <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,1,7,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource Brush.Success}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Risk}" Value="yellow">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Warning}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Risk}" Value="red">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Danger}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding Description}" Margin="0,4,0,0" FontSize="12"
                                   Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,5,0,0">
                            <TextBlock Text="{Binding Compatibility}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" Margin="0,0,12,0"/>
                            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Brush.Accent}" FontSize="11" TextWrapping="Wrap"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding RestartHint}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Margin="12,10,12,10" Padding="14" CornerRadius="10"
                Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Path Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.8"
                          Stroke="{DynamicResource Grad.Orange}" StrokeLineJoin="Round"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M4 7 H20 M4 17 H20 M9 4 V10 M15 14 V20"/>
                    <TextBlock Text="{loc:L10n tweaks.title.system}" FontSize="15" FontWeight="SemiBold"
                               Margin="9,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <WrapPanel Margin="0,12,0,0">
                    <Button x:Name="BtnApply" Style="{DynamicResource PrimaryButton}" Margin="0,0,8,8" Content="{loc:L10n tweaks.apply}" Click="BtnApply_Click"/>
                    <Button x:Name="BtnUndo" Content="{loc:L10n tweaks.undo}" Margin="0,0,8,8" Click="BtnUndo_Click"/>
                    <Button x:Name="BtnRefresh" Content="{loc:L10n tweaks.refresh}" Margin="0,0,8,8" Click="BtnRefresh_Click"/>
                    <Button x:Name="BtnRestorePoint" Content="{loc:L10n tweaks.restorePoint}" Margin="0,0,8,8" Click="BtnRestorePoint_Click"/>
                    <Button x:Name="BtnRestoreBackup" Content="{loc:L10n tweaks.restoreBackup}" Margin="0,0,8,8" Click="BtnRestoreBackup_Click"/>
                </WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Ellipse Width="9" Height="9" Fill="{DynamicResource Brush.Success}" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:L10n tweaks.risk.green}" Margin="5,0,16,0" Foreground="{DynamicResource Brush.TextSecondary}"/>
                    <Ellipse Width="9" Height="9" Fill="{DynamicResource Brush.Warning}" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:L10n tweaks.risk.yellow}" Margin="5,0,16,0" Foreground="{DynamicResource Brush.TextSecondary}"/>
                    <Ellipse Width="9" Height="9" Fill="{DynamicResource Brush.Danger}" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:L10n tweaks.risk.red}" Margin="5,0,16,0" Foreground="{DynamicResource Brush.TextSecondary}"/>
                    <TextBlock x:Name="TxtSelected" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{loc:L10n tweaks.notice}" Margin="0,8,0,0" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" FontSize="12"/>
            </StackPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="PanelGroups" Margin="12,2,14,12"/>
        </ScrollViewer>
    </DockPanel>
</UserControl>
