<UserControl x:Class="WPIC.Views.AppsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WPIC.Services">
    <UserControl.Resources>
        <DataTemplate x:Key="CatalogRowTemplate">
            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="4,9">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"
                              AutomationProperties.Name="{Binding Name}" Margin="0,0,10,0"/>
                    <Grid Grid.Column="1" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Border CornerRadius="7" Background="{Binding TileBrush}">
                            <TextBlock Text="{Binding TileLetter}" FontWeight="Bold" FontSize="15"
                                       Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Image Source="{Binding Icon}" Width="28" Height="28" Stretch="Uniform"
                               Visibility="{Binding IconVisibility}" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Description}" FontSize="12" Margin="0,2,0,0"
                                   Foreground="{DynamicResource Brush.TextSoft}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="110" CornerRadius="6" Padding="8,4" VerticalAlignment="Center"
                                Background="{DynamicResource Brush.FieldBg}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                Visibility="{Binding VersionVisibility}">
                            <TextBlock Text="{Binding VersionLabel}" FontFamily="Consolas" FontSize="11.5"
                                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding VersionLabel}"/>
                        </Border>
                        <TextBlock Text="{Binding Status}" Width="118" Margin="10,0,0,0" FontSize="12"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Installed}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <DockPanel>

        <TabControl x:Name="SubTabs" Margin="12,10,12,12">

            <!-- Каталог -->
            <TabItem x:Name="TabCatalog">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.8"
                              Stroke="{DynamicResource Grad.Cyan}" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M12 2 L21 7 V17 L12 22 L3 17 V7 Z M3 7 L12 12 L21 7 M12 12 V22"/>
                        <TextBlock Text="{loc:L10n apps.tab.catalog}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <DockPanel Margin="0,12,0,0">
                    <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Surface}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                            CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <DockPanel>
                            <TextBlock x:Name="TxtCatalogStatus" DockPanel.Dock="Right" VerticalAlignment="Center"
                                       Margin="14,0,0,0" Foreground="{DynamicResource Brush.TextSecondary}"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnInstallSelected" Style="{DynamicResource PrimaryButton}"
                                        Content="{loc:L10n apps.install.selected}" Click="BtnInstallSelected_Click"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PanelCatalog" Margin="0,0,2,0"/>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- Обновления -->
            <TabItem x:Name="TabUpdates">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.8"
                              Stroke="{DynamicResource Grad.Green}" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M4 12 A8 8 0 0 1 18 7 M20 12 A8 8 0 0 1 6 17 M18 3 V7 H14 M6 21 V17 H10"/>
                        <TextBlock x:Name="TxtUpdatesHeader" Text="{loc:L10n apps.tab.updates}"
                                   Margin="9,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <DockPanel Margin="0,12,0,0">
                    <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Surface}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                            CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <DockPanel>
                            <TextBlock x:Name="TxtUpdatesStatus" DockPanel.Dock="Right" VerticalAlignment="Center"
                                       Margin="14,0,0,0" Foreground="{DynamicResource Brush.TextSecondary}"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnCheckUpdates" Content="{loc:L10n apps.checkUpdates}"
                                        Click="BtnCheckUpdates_Click"/>
                                <Button x:Name="BtnUpgradeSelected" Style="{DynamicResource PrimaryButton}"
                                        Content="{loc:L10n apps.upgrade.selected}" Margin="8,0,0,0"
                                        Click="BtnUpgradeSelected_Click"/>
                                <Button Content="{loc:L10n apps.selectAll}" Margin="8,0,0,0" Click="BtnUpSelAll_Click"/>
                                <Button Content="{loc:L10n apps.selectNone}" Margin="8,0,0,0" Click="BtnUpSelNone_Click"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ItemsUpdates">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Brush.Surface}"
                                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>

                                            <!-- Иконка / плитка -->
                                            <Grid Grid.Column="1" Width="36" Height="36" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <Border CornerRadius="8" Background="{Binding TileBrush}">
                                                    <TextBlock Text="{Binding TileLetter}" FontWeight="Bold" FontSize="17"
                                                               Foreground="#FFFFFFFF" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <Image Source="{Binding Icon}" Width="32" Height="32"
                                                       Stretch="Uniform" Visibility="{Binding IconVisibility}"/>
                                            </Grid>

                                            <StackPanel Grid.Column="2" Margin="12,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Id}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource Brush.TextSecondary}"/>
                                            </StackPanel>

                                            <!-- Версии: текущая → доступная -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="110" CornerRadius="6" Padding="8,4"
                                                        Background="{DynamicResource Brush.FieldBg}"
                                                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                                    <TextBlock Text="{Binding VersionLabel}" FontFamily="Consolas" FontSize="12"
                                                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding VersionLabel}"/>
                                                </Border>
                                                <TextBlock Text="→" Margin="8,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Brush.TextSecondary}"/>
                                                <Border Width="110" CornerRadius="6" Padding="8,4"
                                                        Background="{DynamicResource Brush.CardAccentBg}"
                                                        BorderBrush="{DynamicResource Brush.CardAccentBorder}" BorderThickness="1">
                                                    <TextBlock Text="{Binding AvailableLabel}" FontFamily="Consolas" FontSize="12"
                                                               FontWeight="SemiBold" HorizontalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource Brush.Accent}"
                                                               ToolTip="{Binding AvailableLabel}"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- Поиск в winget -->
            <TabItem x:Name="TabSearch">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.8"
                              Stroke="{DynamicResource Grad.Violet}" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M10 4 A6 6 0 1 0 10 16 A6 6 0 1 0 10 4 M14.5 14.5 L20 20"/>
                        <TextBlock Text="{loc:L10n apps.tab.search}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtWingetBadge" Text="{loc:L10n winget.ui.badge}" Margin="10,0,0,0"
                                   VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Brush.Warning}"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </TabItem.Header>
                <DockPanel Margin="0,12,0,0">
                    <Border x:Name="WingetBanner" DockPanel.Dock="Top" Background="{DynamicResource Brush.CardAccentBg}"
                            BorderBrush="{DynamicResource Brush.Warning}" BorderThickness="1" CornerRadius="8"
                            Padding="12" Margin="0,0,0,10" Visibility="Collapsed">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠" FontSize="15" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.Warning}"/>
                                <TextBlock Text="{loc:L10n winget.ui.notInstalled}" FontWeight="SemiBold" FontSize="13"
                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{loc:L10n winget.ui.desc}" Margin="0,5,0,0" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Brush.TextSecondary}"/>
                            <Button x:Name="BtnWingetInstall" Style="{DynamicResource PrimaryButton}" HorizontalAlignment="Left"
                                    Content="{loc:L10n winget.ui.install}" Margin="0,10,0,0" Click="BtnWingetInstall_Click"/>
                            <StackPanel x:Name="WingetProgressPanel" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
                                <ProgressBar x:Name="WingetProgress" Width="240" Height="14" IsIndeterminate="True"
                                             VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtWingetProgress" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12"
                                           TextTrimming="CharacterEllipsis" MaxWidth="620"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Surface}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                            CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <DockPanel>
                            <Button x:Name="BtnSearch" DockPanel.Dock="Right" Style="{DynamicResource PrimaryButton}"
                                    Content="{loc:L10n apps.search.btn}" MinWidth="110" Margin="10,0,0,0"
                                    Click="BtnSearch_Click"/>
                            <Grid>
                                <TextBox x:Name="TxtSearch" Padding="10,8" FontSize="14" KeyDown="TxtSearch_KeyDown"/>
                                <TextBlock x:Name="TxtSearchHint" Text="{loc:L10n apps.searchHint}"
                                           Foreground="{DynamicResource Brush.TextSecondary}" Margin="12,0,0,0"
                                           VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Grid>
                        </DockPanel>
                    </Border>
                    <TextBlock x:Name="TxtSearchStatus" DockPanel.Dock="Top" Margin="2,0,0,10"
                               Foreground="{DynamicResource Brush.TextSecondary}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ItemsSearchResults">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Brush.Surface}"
                                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                            CornerRadius="8" Padding="14,12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Иконка / плитка -->
                                            <Grid Width="48" Height="48" VerticalAlignment="Top">
                                                <Border CornerRadius="10" Background="{Binding TileBrush}">
                                                    <TextBlock Text="{Binding TileLetter}" FontWeight="Bold" FontSize="22"
                                                               Foreground="#FFFFFFFF" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <Image Source="{Binding Icon}" Width="44" Height="44"
                                                       Stretch="Uniform" Visibility="{Binding IconVisibility}"/>
                                            </Grid>

                                            <!-- Название, идентификатор, описание -->
                                            <StackPanel Grid.Column="1" Margin="14,0,16,0">
                                                <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Id}" FontSize="11.5" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Description}" FontSize="12" Margin="0,7,0,0"
                                                           TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSoft}"/>
                                            </StackPanel>

                                            <!-- Версия и установка: единая колонка -->
                                            <StackPanel Grid.Column="2" Width="160" VerticalAlignment="Top">
                                                <Border CornerRadius="6" Padding="8,5"
                                                        Background="{DynamicResource Brush.FieldBg}"
                                                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                                    <TextBlock Text="{Binding VersionLabel}" FontFamily="Consolas" FontSize="12"
                                                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding VersionLabel}"/>
                                                </Border>
                                                <Button Style="{DynamicResource PrimaryButton}" Margin="0,8,0,0"
                                                        HorizontalAlignment="Stretch"
                                                        Content="{Binding InstallText}" IsEnabled="{Binding CanInstall}"
                                                        Click="BtnInstallSearch_Click" ToolTip="{Binding Id}"/>
                                                <TextBlock Text="{Binding SourceLabel}" FontSize="11" Margin="0,6,0,0"
                                                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource Brush.TextSecondary}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</UserControl>