<UserControl x:Class="WPIC.Views.DriversTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WPIC.Services">
    <DockPanel>
        <!-- 1. Офлайн-подбор: главная функция вкладки -->
        <Border DockPanel.Dock="Top" Margin="8,8,8,8" Padding="14" CornerRadius="10"
                Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Path Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.8"
                          Stroke="{DynamicResource Grad.Blue}" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M2 9 A15 15 0 0 1 22 9 M5 12.5 A10 10 0 0 1 19 12.5 M8.5 16 A5 5 0 0 1 15.5 16 M12 19.5 V19.6"/>
                    <TextBlock Text="{loc:L10n drivers.offline.title}" FontSize="15" FontWeight="SemiBold"
                               Margin="9,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{loc:L10n drivers.offline.desc}" Margin="0,6,0,0" FontSize="12"
                           Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap"/>
                <DockPanel Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button x:Name="BtnNetFix" Style="{DynamicResource PrimaryButton}" Padding="16,8" FontSize="13.5"
                                Content="{loc:L10n drivers.offline.fix}" Click="BtnNetFix_Click"
                                ToolTip="{loc:L10n drivers.offline.fix.tooltip}"/>
                        <Button x:Name="BtnPackBrowse" Margin="8,0,0,0"
                                Click="BtnPackBrowse_Click" ToolTip="{loc:L10n drivers.offline.browse.tooltip}"
                                ToolTipService.InitialShowDelay="200">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.6"
                                      Stroke="{DynamicResource Brush.Accent}" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M3 7 H9 L11 9 H21 V19 H3 Z"/>
                                <TextBlock Text="{loc:L10n drivers.offline.browse}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="TxtPackStatus" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap"/>
                </DockPanel>
                <ItemsControl x:Name="ListNetDevices" Margin="0,10,0,0" Visibility="Collapsed">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,6" Padding="10,8" CornerRadius="8"
                                    Background="{DynamicResource Brush.FieldBg}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DeviceId}" FontFamily="Consolas" FontSize="11"
                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="10,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding State}" FontSize="12"
                                               Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="TxtOfflineStatus" Margin="0,8,0,0" FontSize="12"
                           Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap"/>
                <TextBlock Text="{loc:L10n drivers.offline.tether}" Margin="0,6,0,0" FontSize="11.5"
                           Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- 3. Резервная копия: экспорт до переустановки, восстановление после -->
        <Border DockPanel.Dock="Bottom" Margin="8,8,8,8" Padding="14" CornerRadius="10"
                Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Path Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.8"
                          Stroke="{DynamicResource Grad.Cyan}" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Data="M12 3 L20 6 V12 C20 17 16.5 19.7 12 21 C7.5 19.7 4 17 4 12 V6 Z M8.8 12.2 L11.2 14.6 L15.6 10.2"/>
                    <TextBlock Text="{loc:L10n drivers.backup.title}" FontSize="15" FontWeight="SemiBold"
                               Margin="9,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{loc:L10n drivers.backup.desc}" Margin="0,6,0,0" FontSize="12"
                           Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="BtnDriversExport" Style="{DynamicResource PrimaryButton}"
                            Click="BtnDriversExport_Click" ToolTip="{loc:L10n drivers.backup.export.tooltip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.6"
                                  Stroke="{DynamicResource Brush.AccentText}" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Data="M12 3 V14 M7 9 L12 14 L17 9 M4 17 V20 H20 V17"/>
                            <TextBlock Text="{loc:L10n drivers.backup.export}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <CheckBox x:Name="ChkExport7z" Content="{loc:L10n drivers.backup.compress}" IsChecked="True"
                              Margin="14,0,0,0" VerticalAlignment="Center"
                              ToolTip="{loc:L10n drivers.backup.compress.tooltip}"/>
                    <Button x:Name="BtnDriversRestore" Margin="14,0,0,0"
                            Click="BtnDriversRestore_Click" ToolTip="{loc:L10n drivers.backup.restore.tooltip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.6"
                                  Stroke="{DynamicResource Brush.Accent}" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Data="M12 14 V3 M7 8 L12 3 L17 8 M4 17 V20 H20 V17"/>
                            <TextBlock Text="{loc:L10n drivers.backup.restore}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock x:Name="TxtBackupStatus" Margin="0,8,0,0" FontSize="12"
                           Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- 2. Драйверы на этом ПК: список и проблемные устройства -->
        <Border Margin="8,0,8,0" Padding="14" CornerRadius="10"
                Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Path Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.6"
                              Stroke="{DynamicResource Grad.Orange}" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Data="M6 6 H18 V18 H6 Z M10 10 H14 V14 H10 Z M9 6 V3 M15 6 V3 M9 18 V21 M15 18 V21 M6 9 H3 M6 15 H3 M18 9 H21 M18 15 H21"/>
                        <StackPanel Orientation="Vertical" Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:L10n drivers.installed.title}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:L10n drivers.installed.desc}" FontSize="11.5"
                                       Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnLoad" Style="{DynamicResource PrimaryButton}"
                                Click="BtnLoad_Click" ToolTip="{loc:L10n drivers.load.tooltip}">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.6"
                                      Stroke="{DynamicResource Brush.AccentText}" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Data="M4 6 H20 M4 12 H20 M4 18 H14"/>
                                <TextBlock Text="{loc:L10n drivers.load}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnProblems" Margin="8,0,0,0" Click="BtnProblems_Click"
                                ToolTip="{loc:L10n drivers.problems.tooltip}">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.6"
                                      Stroke="{DynamicResource Brush.Accent}" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M12 3 L22 20 H2 Z M12 9.5 V14 M12 16.6 V16.7"/>
                                <TextBlock Text="{loc:L10n drivers.problems}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Margin="8,0,0,0" Click="BtnWindowsUpdate_Click"
                                ToolTip="{loc:L10n drivers.openWU.tooltip}">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.6"
                                      Stroke="{DynamicResource Brush.Accent}" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M13.5 3 H21 V10.5 M21 3 L11 13 M18 13 V19 H5 V6 H11"/>
                                <TextBlock Text="{loc:L10n drivers.openWU}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
                <Grid Margin="0,12,0,0">
                    <DataGrid x:Name="GridDrivers" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" Visibility="Visible">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:L10n drivers.grid.device}" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="{loc:L10n drivers.grid.vendor}" Binding="{Binding Manufacturer}" Width="180"/>
                            <DataGridTextColumn Header="{loc:L10n drivers.grid.version}" Binding="{Binding Version}" Width="140"/>
                            <DataGridTextColumn Header="{loc:L10n drivers.grid.date}" Binding="{Binding Date}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <DataGrid x:Name="GridProblems" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" Visibility="Collapsed">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:L10n drivers.grid.device}" Binding="{Binding Name}" Width="2*"/>
                            <DataGridTextColumn Header="{loc:L10n drivers.grid.id}" Binding="{Binding DeviceId}" Width="3*"/>
                            <DataGridTextColumn Header="{loc:L10n drivers.grid.error}" Binding="{Binding ErrorCode}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
                <TextBlock DockPanel.Dock="Bottom" Margin="0,10,0,0" FontSize="11.5" Foreground="#FF777777" TextWrapping="Wrap"
                           Text="{loc:L10n drivers.hint}"/>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
