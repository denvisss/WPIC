<Window x:Class="WPIC.Views.ThemedMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WPIC.Services"
        Title="{loc:L10n app.name}"
        Style="{DynamicResource {x:Type Window}}"
        Width="460" MinHeight="150" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="20,18,20,16">
        <DockPanel>
            <TextBlock x:Name="TxtIcon" DockPanel.Dock="Left" FontSize="30" Margin="0,0,14,0"
                       VerticalAlignment="Top" Text=""/>
            <TextBlock x:Name="TxtMessage" TextWrapping="Wrap" FontSize="13" LineHeight="19"/>
        </DockPanel>
        <CheckBox x:Name="ChkOption" Visibility="Collapsed" Margin="0,14,0,0" FontSize="13">
            <CheckBox.Content>
                <TextBlock TextWrapping="Wrap" MaxWidth="360"/>
            </CheckBox.Content>
        </CheckBox>
        <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"/>
    </StackPanel>
</Window>
